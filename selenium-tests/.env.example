# Salin file ini menjadi `.env` (di folder selenium-tests/), lalu isi. File .env TIDAK di-commit.

# Alamat aplikasi yang berjalan di laptop (npm run dev di frontend & backend)
LOKA_BASE_URL=http://localhost:3000
LOKA_API_URL=http://localhost:4000

# Lama menunggu elemen (detik). Naikkan kalau laptop lambat.
E2E_WAIT_SECONDS=10
# Isi 1 untuk menjalankan Chrome tanpa jendela (lebih cepat, tapi prosesnya tidak terlihat)
HEADLESS=0

# ---------------------------------------------------------------------------
# Akun uji khusus E2E. Buat sendiri, JANGAN pakai akun pribadi atau akun teman.
# Hanya akun yang dipakai file tes kamu yang wajib diisi; selebihnya tes di-skip.
# ---------------------------------------------------------------------------

# Penyedia utama: SUDAH punya profil penyedia (dipakai hampir semua PBI penyedia)
E2E_PROVIDER_A_EMAIL=
E2E_PROVIDER_A_PASSWORD=

# Penyedia kedua (TPR-2: cek daftar jasa hanya milik sendiri)
E2E_PROVIDER_B_EMAIL=
E2E_PROVIDER_B_PASSWORD=

# Penyedia tanpa jasa dan tanpa portofolio (TPR-2, TPR-5, TPR-6)
E2E_PROVIDER_EMPTY_EMAIL=
E2E_PROVIDER_EMPTY_PASSWORD=

# Penyedia yang BELUM punya profil sama sekali (TPR-9, TPR-10). Sekali pakai.
E2E_PROVIDER_NEW_EMAIL=
E2E_PROVIDER_NEW_PASSWORD=

# Customer (TPR-1, TPR-2, TPR-9, TPR-13, TPR-14, TPR-21, TPR-22)
E2E_CUSTOMER_A_EMAIL=
E2E_CUSTOMER_A_PASSWORD=
E2E_CUSTOMER_B_EMAIL=
E2E_CUSTOMER_B_PASSWORD=

# Admin (TPR-1, TPR-21, TPR-22). Role admin diset lewat SQL, bukan lewat halaman Daftar.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Opsional, hanya untuk TC.PAY.004.x (mengubah masa berlaku sesi pembayaran).
# Kunci service role sangat sensitif: jangan dibagikan dan jangan di-commit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
